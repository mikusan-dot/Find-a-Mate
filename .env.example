# ---------- Client (copy to client/.env) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- Server (copy to server/.env) ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Long random string, used to HMAC student IDs. Never change after launch.
STUDENT_ID_PEPPER=
# Optional: OpenAI-compatible provider for explanations/icebreakers only
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Opt-in demo data (always flagged demo:true)
ALLOW_DEMO_DATA=false
